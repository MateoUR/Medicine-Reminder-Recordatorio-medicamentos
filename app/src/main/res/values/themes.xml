<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryDark">@color/blue_dark</item>
        <item name="colorAccent">@color/blue_primary</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Boton azul uniforme, equivalente a make_button() de Python -->
    <style name="AppButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/blue_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>

    <!-- Label azul oscuro -->
    <style name="AppLabel">
        <item name="android:textColor">@color/blue_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <!-- Campo de texto -->
    <style name="AppInput">
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:background">@android:drawable/edit_text</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

</resources>
