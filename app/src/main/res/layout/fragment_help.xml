<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/bg_menu" android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:paddingHorizontal="32dp" android:gravity="center">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Para soporte contactar:"
            android:textColor="@color/blue_dark" android:textSize="16sp"
            android:gravity="center" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="mateo.underblade@gmail.com"
            android:textColor="@color/blue_primary" android:textSize="16sp"
            android:gravity="center" android:layout_marginBottom="32dp" />

        <Button android:id="@+id/btnBack" android:layout_width="match_parent"
            android:layout_height="48dp" android:text="Volver al Menu"
            style="@style/AppButton" />

    </LinearLayout>
</FrameLayout>
